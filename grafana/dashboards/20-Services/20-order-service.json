      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 2}, "id": 3,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "sum(rate(order_service_http_requests_total{status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(order_service_http_requests_total[5m])), 0.001)", "legendFormat": "Erreurs 5xx", "refId": "A"}],
      "title": "Errors — taux 5xx", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
