      "targets": [{"expr": "sum(rate(pg_stat_database_blks_hit{datname=\"ecommerce\"}[$__rate_interval])) / clamp_min(sum(rate(pg_stat_database_blks_hit{datname=\"ecommerce\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read{datname=\"ecommerce\"}[$__rate_interval])), 0.001)", "legendFormat": "Buffer cache hit ratio", "refId": "A"}],
      "title": "Cache hit ratio (objectif >99%)", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "unit": "short",
