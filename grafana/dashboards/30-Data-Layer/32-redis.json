  "panels": [
    {
      "gridPos": {"h": 2, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {"content": "## 32 — Redis · Méthode USE\n**Utilization** (mémoire, commandes/s) · **Saturation** (connexions, évictions) · **Errors** (connexions rejetées)\n**Source**: redis_exporter · **Refresh**: 30s", "mode": "markdown"},
      "title": "", "type": "text"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [{"options": {"0": {"color": "red", "text": "DOWN"}, "1": {"color": "green", "text": "UP"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 2}, "id": 2,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "value_and_name"},
      "targets": [{"expr": "redis_up", "legendFormat": "Redis", "refId": "A"}],
      "title": "Status", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "unit": "bytes",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 2}, "id": 3,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"},
      "targets": [{"expr": "redis_memory_used_bytes", "legendFormat": "Mémoire utilisée", "refId": "A"}],
      "title": "Mémoire utilisée", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.75}, {"color": "red", "value": 0.90}]}}},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 2}, "id": 4,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"},
      "targets": [{"expr": "redis_memory_used_bytes / clamp_min(redis_memory_max_bytes, 1)", "legendFormat": "Utilisation mémoire", "refId": "A"}],
      "title": "Saturation mémoire", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.80}, {"color": "green", "value": 0.90}]}}},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 2}, "id": 5,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"},
      "targets": [{"expr": "rate(redis_keyspace_hits_total[$__rate_interval]) / clamp_min(rate(redis_keyspace_hits_total[$__rate_interval]) + rate(redis_keyspace_misses_total[$__rate_interval]), 0.001)", "legendFormat": "Cache hit rate", "refId": "A"}],
      "title": "Cache hit rate (objectif >90%)", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 50}, {"color": "red", "value": 100}]}}},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 2}, "id": 6,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"},
      "targets": [{"expr": "redis_connected_clients", "legendFormat": "Clients connectés", "refId": "A"}],
      "title": "Clients connectés", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 10}]}}},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 2}, "id": 7,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"},
      "targets": [{"expr": "increase(redis_rejected_connections_total[$__rate_interval])", "legendFormat": "Connexions rejetées", "refId": "A"}],
      "title": "Connexions rejetées", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 15, "lineWidth": 2}, "unit": "bytes"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}, "id": 8,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}},
      "targets": [
        {"expr": "redis_memory_used_bytes", "legendFormat": "Mémoire utilisée", "refId": "A"},
        {"expr": "redis_memory_used_peak_bytes", "legendFormat": "Pic mémoire", "refId": "B"},
        {"expr": "redis_memory_max_bytes", "legendFormat": "Limite max", "refId": "C"}
      ],
      "title": "Mémoire (utilisée / pic / limite)", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2}, "unit": "ops"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}, "id": 9,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}},
      "targets": [
        {"expr": "rate(redis_commands_processed_total[$__rate_interval])", "legendFormat": "Commandes/s total", "refId": "A"},
        {"expr": "rate(redis_keyspace_hits_total[$__rate_interval])", "legendFormat": "Cache hits/s", "refId": "B"},
        {"expr": "rate(redis_keyspace_misses_total[$__rate_interval])", "legendFormat": "Cache misses/s", "refId": "C"}
      ],
      "title": "Throughput commandes + cache hit/miss", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14}, "id": 10,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}},
      "targets": [
        {"expr": "redis_db_keys", "legendFormat": "Clés totales (DB {{db}})", "refId": "A"},
        {"expr": "redis_db_keys_expiring", "legendFormat": "Clés avec TTL (DB {{db}})", "refId": "B"}
      ],
      "title": "Keyspace — clés totales et avec TTL", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14}, "id": 11,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["sum", "max"]}},
      "targets": [
        {"expr": "increase(redis_evicted_keys_total[$__rate_interval])", "legendFormat": "Évictions (LRU)", "refId": "A"},
        {"expr": "increase(redis_expired_keys_total[$__rate_interval])", "legendFormat": "Expirations (TTL)", "refId": "B"}
      ],
      "title": "Évictions (alerte si > 0) et expirations TTL", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1.5}, {"color": "red", "value": 2}]}}},
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 22}, "id": 12,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"},
      "targets": [{"expr": "redis_mem_fragmentation_ratio", "legendFormat": "Fragmentation ratio", "refId": "A"}],
      "title": "Fragmentation ratio (idéal ~1.0)", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "unit": "dateTimeFromNow",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}},
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 22}, "id": 13,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"},
      "targets": [{"expr": "redis_rdb_last_save_timestamp_seconds * 1000", "legendFormat": "Dernière sauvegarde", "refId": "A"}],
      "title": "Dernière sauvegarde RDB", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "unit": "s",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}},
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 22}, "id": 14,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"},
      "targets": [{"expr": "redis_uptime_in_seconds", "legendFormat": "Uptime", "refId": "A"}],
      "title": "Uptime Redis", "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["ecommerce", "cache", "redis"],
